# Copy to `.env` on the VPS (or locally). Never commit `.env`.

# Public URL Mealie uses for links, emails, and OAuth callbacks
BASE_URL=https://recipes.example.com

# PostgreSQL (used by Mealie when DB_ENGINE=postgres)
POSTGRES_USER=mealie
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
POSTGRES_DB=mealie

# Mealie
ALLOW_SIGNUP=false
# Default timezone for meal planner (IANA name)
TZ=America/New_York

# Optional: first-run bootstrap (remove after creating your admin user)
# DEFAULT_EMAIL=admin@example.com
# DEFAULT_PASSWORD=change-me-immediately
